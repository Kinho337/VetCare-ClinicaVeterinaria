@model Tutor
@{ ViewData["Title"] = "Editar tutor"; }
<div class="page-heading"><div><div class="eyebrow">CADASTROS</div><h1 class="page-title">Editar tutor</h1></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Voltar</a></div>
<div class="content-card form-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="CriadoEm"/><partial name="_Form" model="Model"/><div class="mt-4"><button class="btn btn-primary">Salvar alterações</button></div></form></div>
