@model Tutor
@{ ViewData["Title"] = "Detalhes do tutor"; }
<div class="page-heading"><div><div class="eyebrow">PERFIL DO TUTOR</div><h1 class="page-title">@Model.Nome</h1><p class="text-muted mb-0">Cadastro e animais vinculados.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar tutor</a><a class="btn btn-primary" asp-controller="Animais" asp-action="Create" asp-route-tutorId="@Model.Id">+ Adicionar animal</a></div></div>
<div class="content-card mb-4"><div class="d-flex flex-wrap gap-3 align-items-center">@if(!string.IsNullOrEmpty(Model.FotoPerfil)){<img class="profile-photo" src="@Model.FotoPerfil" alt="Foto do tutor"/>}else{<div class="profile-photo avatar-placeholder">@Model.Nome[..1]</div>}<div><h2 class="section-title mb-1">@Model.Nome</h2><div class="text-muted">@Model.Email · @Model.Telefone</div><div class="text-muted">CPF: @Model.CPF</div><div class="text-muted">@Model.Endereco</div></div></div></div>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="section-title">Animais vinculados (@Model.Animais.Count)</h2><a asp-controller="Animais" asp-action="Index">Todos os animais</a></div>
<div class="row g-3">@foreach(var a in Model.Animais){<div class="col-md-6 col-xl-4"><div class="content-card h-100"><div class="d-flex gap-3 align-items-center">@if(!string.IsNullOrEmpty(a.FotoPerfil)){<img class="pet-photo" src="@a.FotoPerfil" alt="Foto de @a.Nome"/>}else{<div class="pet-photo avatar-placeholder">P</div>}<div><h3 class="section-title mb-1">@a.Nome</h3><div class="text-muted small">@a.Especie · @(a.Raca ?? "Raça não informada")</div><a asp-controller="Animais" asp-action="Details" asp-route-id="@a.Id">Ver perfil e histórico →</a></div></div></div></div>}</div>
@if(!Model.Animais.Any()){<div class="empty-state"><p>Este tutor ainda não possui animais cadastrados.</p><a class="btn btn-primary" asp-controller="Animais" asp-action="Create" asp-route-tutorId="@Model.Id">Cadastrar primeiro animal</a></div>}
