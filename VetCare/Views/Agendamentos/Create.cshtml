@model AgendamentoViewModel
@{ ViewData["Title"] = "Novo agendamento"; }
<div class="page-heading"><div><div class="eyebrow">AGENDA</div><h1 class="page-title">Novo agendamento</h1><p class="text-muted">Selecione o paciente, o serviço e o profissional.</p></div><a class="btn btn-light" asp-action="Index">Voltar</a></div>
<div class="content-card form-card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Animal / tutor *</label><select asp-for="AnimalId" asp-items="Model.Animais" class="form-select"><option value="">Selecione o animal</option></select><span asp-validation-for="AnimalId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Veterinário *</label><select asp-for="VeterinarioId" asp-items="Model.Veterinarios" class="form-select"><option value="">Selecione o veterinário</option></select><span asp-validation-for="VeterinarioId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Serviço *</label><select asp-for="ServicoId" asp-items="Model.Servicos" class="form-select"><option value="">Selecione o serviço</option></select><span asp-validation-for="ServicoId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="DataHora" class="form-label">Data e horário *</label><input asp-for="DataHora" type="datetime-local" class="form-control" value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")"/><span asp-validation-for="DataHora" class="text-danger"></span></div><div class="col-12"><label asp-for="Observacoes" class="form-label">Observações</label><textarea asp-for="Observacoes" class="form-control" rows="3"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Criar agendamento</button></div></form></div>
