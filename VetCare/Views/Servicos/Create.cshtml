@model Servico
@{ ViewData["Title"] = "Novo serviço"; }
<div class="page-heading"><div><div class="eyebrow">CONFIGURAÇÕES</div><h1 class="page-title">Novo serviço</h1></div><a class="btn btn-light" asp-action="Index">Voltar</a></div>
<div class="content-card form-card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Nome" class="form-label">Nome *</label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div><div class="mb-3"><label asp-for="Descricao" class="form-label">Descrição</label><textarea asp-for="Descricao" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Preco" class="form-label">Preço (R$)</label><input asp-for="Preco" class="form-control" type="number" step="0.01" min="0"/></div><div class="form-check mb-3"><input asp-for="Ativo" class="form-check-input"/><label asp-for="Ativo" class="form-check-label">Ativo</label></div><button class="btn btn-primary">Salvar serviço</button></form></div>
