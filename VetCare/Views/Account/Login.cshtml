@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_Layout";
}
<div class="auth-page login-page">
 <section class="auth-story">
  <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="VetCare"><img src="~/images/vetcare-logo-white.png" alt="" /><span>Vet<span>Care</span></span></a>
  <span class="eyebrow light-eyebrow">CUIDADO EM CADA DETALHE</span>
  <h1>Mais saúde, mais carinho, mais momentos juntos.</h1>
  <p>Um espaço leve para acompanhar a saúde de quem faz parte da sua família — do focinho à pontinha do rabo.</p>
  <div class="story-pills"><span>♡ Histórico de saúde</span><span>✦ Consultas e vacinas</span><span>⌂ Família conectada</span></div>
  <div class="story-pet-scene" aria-hidden="true"><span class="scene-spark spark-one">✦</span><span class="scene-spark spark-two">♡</span><div class="scene-orbit orbit-one"></div><div class="scene-orbit orbit-two"></div><div class="scene-pet scene-dog">🐶</div><div class="scene-pet scene-cat">🐱</div><div class="scene-paw">🐾</div></div>
  <div class="story-caption"><span class="caption-dot"></span> Um cuidado que acompanha vocês</div>
 </section>
 <section class="auth-form-wrap"><div class="auth-form-card">
  <div class="mobile-auth-brand"><img src="~/images/vetcare-logo.png" alt="" /><span>Vet<span>Care</span></span></div>
  <span class="eyebrow">BEM-VINDO DE VOLTA</span><h2>Que bom ter você aqui.</h2>
  <p class="auth-intro">Entre na sua conta e fique pertinho dos cuidados do seu pet.</p>
  <form asp-action="Login" method="post">
   <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
   <div asp-validation-summary="ModelOnly" class="text-danger auth-validation mb-3"></div>
   <div class="mb-3"><label asp-for="Email" class="form-label">E-mail</label><div class="input-with-icon"><span aria-hidden="true">✉</span><input asp-for="Email" class="form-control form-control-lg" placeholder="seu@email.com" autocomplete="username" /></div><span asp-validation-for="Email" class="text-danger small"></span></div>
   <div class="mb-4"><label asp-for="Senha" class="form-label">Senha</label><div class="input-with-icon"><span aria-hidden="true">♙</span><input asp-for="Senha" class="form-control form-control-lg" placeholder="Sua senha" autocomplete="current-password" /></div><span asp-validation-for="Senha" class="text-danger small"></span></div>
   <button class="btn btn-primary btn-lg w-100 auth-submit">Entrar na minha conta <span aria-hidden="true">→</span></button>
  </form>
  <div class="login-help"><span class="help-icon">♡</span><span><strong>É sua primeira visita?</strong><small>Crie seu acesso para acompanhar seus pets.</small></span><a asp-action="Register">Criar conta</a></div>
  <p class="auth-privacy">Seus dados e o histórico de saúde dos seus pets ficam protegidos.</p>
 </div></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
