@model RegisterViewModel
@{
    ViewData["Title"] = "Criar minha conta";
}
<div class="auth-page register-page">
 <section class="auth-story">
  <a class="auth-brand" asp-controller="Home" asp-action="Index" aria-label="VetCare"><img src="~/images/vetcare-logo-white.png" alt="" /><span>Vet<span>Care</span></span></a>
  <span class="eyebrow light-eyebrow">A FAMÍLIA CRESCE POR AQUI</span>
  <h1>Todo pet merece uma vida cheia de cuidado.</h1>
  <p>Crie sua conta para acompanhar consultas, vacinas e o histórico de saúde. Você também pode conectar pets que já têm uma ficha na clínica.</p>
  <div class="story-pills"><span>♡ Seus pets em um só lugar</span><span>✦ Histórico de cuidados</span><span>⌂ Vínculo familiar</span></div>
  <div class="story-pet-scene" aria-hidden="true"><span class="scene-spark spark-one">✦</span><span class="scene-spark spark-two">♡</span><div class="scene-orbit orbit-one"></div><div class="scene-orbit orbit-two"></div><div class="scene-pet scene-dog">🐶</div><div class="scene-pet scene-cat">🐱</div><div class="scene-paw">🐾</div></div>
  <div class="story-caption"><span class="caption-dot"></span> Mais carinho em cada etapa</div>
 </section>
 <section class="auth-form-wrap"><div class="auth-form-card register-form-card">
  <div class="mobile-auth-brand"><img src="~/images/vetcare-logo.png" alt="" /><span>Vet<span>Care</span></span></div>
  <span class="eyebrow">SUA CONTA</span><h2>Vamos nos conhecer?</h2>
  <p class="auth-intro">Seus dados ajudam a conectar você aos pets certos.</p>
  <form asp-action="Register" method="post">
   <div asp-validation-summary="ModelOnly" class="text-danger auth-validation mb-3"></div>
   <div class="mb-3"><label asp-for="Nome" class="form-label">Nome completo</label><input asp-for="Nome" class="form-control" autocomplete="name" placeholder="Como podemos te chamar?"/><span asp-validation-for="Nome" class="text-danger small"></span></div>
   <div class="row g-3"><div class="col-md-6"><label asp-for="CPF" class="form-label"></label><input asp-for="CPF" class="form-control" inputmode="numeric" placeholder="Somente números"/><span asp-validation-for="CPF" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" autocomplete="tel" placeholder="(11) 99999-9999"/><span asp-validation-for="Telefone" class="text-danger small"></span></div></div>
   <div class="mt-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="voce@email.com"/><span asp-validation-for="Email" class="text-danger small"></span></div>
   <div class="mt-3"><label asp-for="Endereco" class="form-label"></label><input asp-for="Endereco" class="form-control" autocomplete="street-address" placeholder="Rua, número, bairro"/></div>
   <div class="row g-3 mt-0"><div class="col-md-6"><label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="new-password" placeholder="Pelo menos 8 caracteres"/><span asp-validation-for="Senha" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ConfirmarSenha" class="form-label"></label><input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" placeholder="Repita a senha"/><span asp-validation-for="ConfirmarSenha" class="text-danger small"></span></div></div>
   <button class="btn btn-primary btn-lg w-100 mt-4 auth-submit">Criar minha conta <span aria-hidden="true">→</span></button>
  </form>
  <p class="text-center small mt-4 mb-0">Já tem uma conta? <a asp-action="Login" class="fw-bold">Entrar</a></p>
  <p class="auth-privacy">Se o seu pet já estiver cadastrado, você poderá solicitar um vínculo sem criar uma ficha duplicada.</p>
 </div></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
