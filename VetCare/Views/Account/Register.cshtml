@model RegisterViewModel
@{
    ViewData["Title"] = "Criar minha conta";
}
<div class="auth-page">
    <div class="auth-story">
        <div class="brand-symbol">✿</div>
        <span class="eyebrow light-eyebrow">BEM-VINDO À VETCARE</span>
        <h1>O cuidado do seu pet, pertinho de você.</h1>
        <p>Acompanhe consultas, veja o histórico de cuidados e mantenha a família conectada à saúde de quem faz parte dela.</p>
        <div class="story-pills"><span>♡ Histórico de saúde</span><span>✦ Agenda organizada</span><span>⌂ Família conectada</span></div>
        <div class="story-illustration" aria-hidden="true">🐾</div>
    </div>
    <div class="auth-form-wrap">
        <div class="auth-form-card">
            <span class="eyebrow">SUA CONTA</span>
            <h2>Vamos nos conhecer?</h2>
            <p class="text-muted mb-4">Crie seu acesso de tutor em poucos passos.</p>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" autocomplete="name" placeholder="Como podemos te chamar?"/><span asp-validation-for="Nome" class="text-danger"></span></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="CPF" class="form-label"></label><input asp-for="CPF" class="form-control" inputmode="numeric" placeholder="Somente números"/><span asp-validation-for="CPF" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" autocomplete="tel" placeholder="(11) 99999-9999"/><span asp-validation-for="Telefone" class="text-danger"></span></div>
                </div>
                <div class="mt-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="voce@email.com"/><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="mt-3"><label asp-for="Endereco" class="form-label"></label><input asp-for="Endereco" class="form-control" autocomplete="street-address" placeholder="Rua, número, bairro"/></div>
                <div class="row g-3 mt-0">
                    <div class="col-md-6"><label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="new-password" placeholder="Pelo menos 8 caracteres"/><span asp-validation-for="Senha" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="ConfirmarSenha" class="form-label"></label><input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" placeholder="Repita a senha"/><span asp-validation-for="ConfirmarSenha" class="text-danger"></span></div>
                </div>
                <button class="btn btn-primary btn-lg w-100 mt-4">Criar minha conta <span aria-hidden="true">→</span></button>
            </form>
            <p class="text-center small mt-4 mb-0">Já tem uma conta? <a asp-action="Login" class="fw-bold">Entrar</a></p>
            <p class="privacy-note">Seus dados são usados para identificar seu cadastro e conectar você aos pets corretos. O vínculo com um animal já cadastrado é confirmado pela clínica.</p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
