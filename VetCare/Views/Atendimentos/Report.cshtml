@model Atendimento
@{ ViewData["Title"] = "Relatório da consulta"; }
<div class="d-flex justify-content-between align-items-center mb-3 no-print"><div><div class="eyebrow">DOCUMENTO CLÍNICO</div><h1 class="page-title">Relatório da consulta</h1></div><div class="d-flex gap-2"><button class="btn btn-primary" onclick="window.print()">Imprimir / salvar PDF</button><a class="btn btn-light" asp-action="Index">Voltar</a></div></div>
<div class="report-sheet">
 <div class="report-header"><div class="report-logo">V</div><div><h1>VetCare</h1><p>Relatório de atendimento veterinário</p></div><div class="ms-auto text-end"><strong>Consulta #@Model.Id</strong><div>@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</div></div></div>
 <section><h2>Paciente</h2><div class="report-grid">@if(!string.IsNullOrEmpty(Model.Animal?.FotoPerfil)){<img class="report-pet-photo" src="@Model.Animal.FotoPerfil" alt="Foto do animal"/>}<div><strong>Nome:</strong> @Model.Animal?.Nome<br/><strong>Espécie:</strong> @Model.Animal?.Especie<br/><strong>Raça:</strong> @(Model.Animal?.Raca ?? "Não informada")<br/><strong>Sexo:</strong> @(Model.Animal?.Sexo ?? "Não informado")<br/><strong>Identificação:</strong> @(Model.Animal?.Identificacao ?? "Não informada")</div></div></section>
 <section><h2>Tutor responsável</h2><strong>Nome:</strong> @Model.Animal?.Tutor?.Nome<br/><strong>CPF:</strong> @Model.Animal?.Tutor?.CPF<br/><strong>E-mail:</strong> @Model.Animal?.Tutor?.Email<br/><strong>Telefone:</strong> @Model.Animal?.Tutor?.Telefone<br/><strong>Endereço:</strong> @Model.Animal?.Tutor?.Endereco</section>
 <section><h2>Atendimento</h2><strong>Veterinário:</strong> @Model.Veterinario?.Nome<br/><strong>CRMV:</strong> @Model.Veterinario?.CRMV<br/><strong>Serviço:</strong> @(Model.Agendamento?.Servico?.Nome ?? "Consulta / atendimento")<div class="report-field"><h3>Queixa / motivo</h3><p>@Model.Queixa</p></div><div class="report-field"><h3>Diagnóstico</h3><p>@Model.Diagnostico</p></div><div class="report-field"><h3>Observações e plano de tratamento</h3><p>@(Model.Observacoes ?? "Não informado")</p></div><div class="report-field"><h3>Medicações recomendadas</h3><p>@(Model.MedicacoesRecomendadas ?? "Não informado")</p></div>
 @if(!string.IsNullOrEmpty(Model.FotoAtendimento)){<div class="report-field"><h3>Imagem anexada ao atendimento</h3><img class="report-attachment" src="@Model.FotoAtendimento" alt="Imagem do atendimento"/></div>}
 </section>
 <div class="report-signature"><div></div><span>@Model.Veterinario?.Nome<br/>CRMV: @Model.Veterinario?.CRMV</span></div>
 <div class="report-footer">Documento gerado pelo VetCare · Os registros devem ser conferidos pelo profissional responsável.</div>
</div>
