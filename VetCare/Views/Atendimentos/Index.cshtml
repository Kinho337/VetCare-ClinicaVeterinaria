@model IEnumerable<Atendimento>
@{ ViewData["Title"] = "Atendimentos"; }
<div class="page-heading"><div><div class="eyebrow">PRONTUÁRIOS</div><h1 class="page-title">Atendimentos</h1><p class="text-muted">Histórico de consultas e registros clínicos.</p></div><a class="btn btn-primary" asp-action="Create">+ Novo atendimento</a></div>
<div class="content-card table-responsive"><table class="table align-middle"><thead><tr><th>Data</th><th>Animal / tutor</th><th>Veterinário</th><th>Diagnóstico</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@a.Animal?.Nome</strong><div class="small text-muted">@a.Animal?.Tutor?.Nome</div></td><td>@a.Veterinario?.Nome</td><td>@(a.Diagnostico.Length > 80 ? a.Diagnostico[..80] + "…" : a.Diagnostico)</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Report" asp-route-id="@a.Id">Relatório</a></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Nenhum atendimento registrado.</td></tr>}</tbody></table></div>
