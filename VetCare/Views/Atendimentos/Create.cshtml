@model Atendimento
@{ ViewData["Title"] = "Registrar atendimento"; }
<div class="page-heading"><div><div class="eyebrow">PRONTUÁRIO</div><h1 class="page-title">Registrar atendimento</h1><p class="text-muted">Registre as informações clínicas da consulta.</p></div><a class="btn btn-light" asp-action="Index">Voltar</a></div>
<div class="content-card form-card"><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Animal *</label><select asp-for="AnimalId" asp-items="ViewBag.Animais" class="form-select"></select><span asp-validation-for="AnimalId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Veterinário *</label><select asp-for="VeterinarioId" asp-items="ViewBag.Veterinarios" class="form-select"></select><span asp-validation-for="VeterinarioId" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Agendamento (opcional)</label><select asp-for="AgendamentoId" asp-items="ViewBag.Agendamentos" class="form-select"><option value="">Sem agendamento</option></select></div><div class="col-md-6"><label asp-for="DataHora" class="form-label">Data e hora</label><input asp-for="DataHora" type="datetime-local" class="form-control" value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm")"/></div><div class="col-12"><label asp-for="Queixa" class="form-label">Queixa / motivo da consulta *</label><textarea asp-for="Queixa" class="form-control" rows="2"></textarea><span asp-validation-for="Queixa" class="text-danger"></span></div><div class="col-12"><label asp-for="Diagnostico" class="form-label">Diagnóstico *</label><textarea asp-for="Diagnostico" class="form-control" rows="3"></textarea><span asp-validation-for="Diagnostico" class="text-danger"></span></div><div class="col-12"><label asp-for="Observacoes" class="form-label">Observações e plano de tratamento</label><textarea asp-for="Observacoes" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="MedicacoesRecomendadas" class="form-label">Medicações recomendadas e instruções</label><textarea asp-for="MedicacoesRecomendadas" class="form-control" rows="3"></textarea></div><div class="col-12"><partial name="_PhotoField" model="Model.FotoAtendimento"/></div></div><div class="mt-4"><button class="btn btn-primary">Salvar e gerar relatório</button></div></form></div>
