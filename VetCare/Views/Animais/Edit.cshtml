@model Animal
@{ ViewData["Title"] = "Editar animal"; }
<div class="page-heading"><div><div class="eyebrow">CADASTROS · PACIENTES</div><h1 class="page-title">Editar ficha do pet</h1><p class="text-muted mb-0">Atualize os dados sem perder o histórico clínico nem os vínculos familiares.</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Voltar à ficha</a></div>
<div class="content-card form-card animal-form-card"><form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="FotoPerfil"/><partial name="_Form" model="Model"/><div class="d-flex flex-wrap justify-content-end gap-2 mt-4 pt-3 border-top"><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a><button type="submit" class="btn btn-primary px-4">Salvar alterações</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
