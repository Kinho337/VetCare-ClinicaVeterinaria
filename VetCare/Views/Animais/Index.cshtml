@model IEnumerable<Animal>
@{ ViewData["Title"] = "Animais"; }
<div class="page-heading"><div><div class="eyebrow">CADASTROS</div><h1 class="page-title">Animais</h1><p class="text-muted">Perfis dos pacientes da clínica.</p></div><a class="btn btn-primary" asp-action="Create">+ Novo animal</a></div>
<form class="search-bar mb-3" method="get"><input name="busca" class="form-control" placeholder="Buscar por animal ou tutor..." value="@Context.Request.Query["busca"]"/><button class="btn btn-outline-primary">Buscar</button></form>
<div class="content-card table-responsive"><table class="table align-middle"><thead><tr><th>Animal</th><th>Espécie / raça</th><th>Tutor</th><th></th></tr></thead><tbody>
@foreach(var a in Model){<tr><td><div class="d-flex align-items-center gap-2">@if(!string.IsNullOrEmpty(a.FotoPerfil)){<img class="avatar" src="@a.FotoPerfil" alt=""/>}else{<span class="avatar avatar-placeholder">P</span>}<strong>@a.Nome</strong></div></td><td>@a.Especie<div class="small text-muted">@a.Raca</div></td><td><a asp-controller="Tutores" asp-action="Details" asp-route-id="@a.TutorId">@a.Tutor?.Nome</a></td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@a.Id">Perfil</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Nenhum animal cadastrado.</td></tr>}
</tbody></table></div>
