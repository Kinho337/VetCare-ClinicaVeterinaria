@model Animal
@{ ViewData["Title"] = "Perfil do animal"; }
<div class="page-heading"><div><div class="eyebrow">PACIENTE</div><h1 class="page-title">@Model.Nome</h1><p class="text-muted">Perfil e histórico clínico.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-primary" asp-controller="Atendimentos" asp-action="Create">+ Registrar atendimento</a></div></div>
<div class="content-card mb-4"><div class="d-flex flex-wrap gap-3 align-items-center">@if(!string.IsNullOrEmpty(Model.FotoPerfil)){<img class="profile-photo" src="@Model.FotoPerfil" alt="Foto do animal"/>}else{<div class="profile-photo avatar-placeholder">P</div>}<div><h2 class="section-title">@Model.Nome</h2><p class="mb-1">@Model.Especie · @(Model.Raca ?? "Raça não informada") · @(Model.Sexo ?? "Sexo não informado")</p><p class="text-muted mb-1">Tutor: <a asp-controller="Tutores" asp-action="Details" asp-route-id="@Model.TutorId">@Model.Tutor?.Nome</a></p><p class="text-muted mb-0">Identificação: @(Model.Identificacao ?? "Não informada")</p></div></div></div>
<div class="content-card"><h2 class="section-title mb-3">Histórico de atendimentos</h2><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Veterinário</th><th>Diagnóstico</th><th></th></tr></thead><tbody>@foreach(var at in Model.Atendimentos.OrderByDescending(x=>x.DataHora)){<tr><td>@at.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@at.Veterinario?.Nome</td><td>@(at.Diagnostico.Length > 100 ? at.Diagnostico[..100] + "…" : at.Diagnostico)</td><td><a asp-controller="Atendimentos" asp-action="Report" asp-route-id="@at.Id">Relatório</a></td></tr>}@if(!Model.Atendimentos.Any()){<tr><td colspan="4" class="text-muted text-center py-3">Sem atendimentos registrados.</td></tr>}</tbody></table></div></div>
