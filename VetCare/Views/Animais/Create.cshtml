@model Animal
@{ ViewData["Title"] = "Novo animal"; }
<div class="page-heading"><div><div class="eyebrow">CADASTROS · PACIENTES</div><h1 class="page-title">Adicionar um pet</h1><p class="text-muted mb-0">Crie a ficha do paciente e associe ao tutor responsável.</p></div><a class="btn btn-light" asp-action="Index">Voltar aos pacientes</a></div>
